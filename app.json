{
  "expo": {
    "name": "FX Utilities",
    "slug": "fx-utilities-mobile-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "msauth.co.uk.fxutilities.mobileapp",
    "ios": {
      "bundleIdentifier": "co.uk.fxutilities.mobileapp",
      "supportsTablet": true
    },
    "android": {
      "package": "co.uk.fxutilities.mobileapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "aafbc4db-65d1-4f2d-a38d-492c9015dd5a"
      }
    }
  }
}
